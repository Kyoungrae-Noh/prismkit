{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prismkit-git",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_ENABLED": "true",
    "ACCESS_ISSUER": "https://comic-test-pages.cloudflareaccess.com",
    "ACCESS_AUD": "26ec13b3c8d38c2d9d11d84d0fcca7d431be8f172812dae35dfc9716d1000869",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SEARCHAD",
        "class_name": "SearchAdBudget",
        "script_name": "prismkit-searchad",
      },
    ],
  },
  "env": {
    "preview": {
      "vars": {
        "AI_ENABLED": "false",
        "ACCESS_ISSUER": "https://comic-test-pages.cloudflareaccess.com",
        "ACCESS_AUD": "26ec13b3c8d38c2d9d11d84d0fcca7d431be8f172812dae35dfc9716d1000869",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SEARCHAD",
            "class_name": "SearchAdBudget",
            "script_name": "prismkit-searchad",
          },
        ],
      },
      "secrets": {
        "required": ["ADMIN_EMAIL"],
      },
    },
  },
  "secrets": {
    "required": ["ADMIN_EMAIL"],
  },
}
