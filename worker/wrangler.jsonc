{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "prismkit-searchad",
  "main": "index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "AI_COST_APPROVAL": "gpt-4.1-mini-2025-04-14:daily30:monthly5USD:2026-11-21",
    "DRAFT_COST_APPROVAL": "gpt-4.1-mini-2025-04-14:daily5:monthly1.50USD:2026-11-21",
  },
  "observability": {
    "enabled": false,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SEARCHAD",
        "class_name": "SearchAdBudget",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SearchAdBudget"],
    },
  ],
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "NAVER_SEARCHAD_API_KEY",
      "NAVER_SEARCHAD_SECRET_KEY",
      "NAVER_SEARCHAD_CUSTOMER_ID",
    ],
  },
}
